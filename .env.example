# EmpathyLink Environment Variables Template
# NEVER commit real production secrets or API keys.

# Database (PostgreSQL)
DATABASE_URL="postgresql://empathy_user:empathy_pass@localhost:5432/empathylink?schema=public"

# Redis (Caching, Presence, Rate Limiting)
REDIS_URL="redis://localhost:6379"

# Cryptography & Session Tokens (Must be high-entropy, >= 32 characters in production)
JWT_ACCESS_SECRET="development_super_secret_access_key_min_32_bytes_long_safe_dev_only!"
JWT_REFRESH_SECRET="development_super_secret_refresh_key_min_32_bytes_long_safe_dev_only!"
COOKIE_SECRET="development_cookie_secret_key_min_32_chars_safe_dev_only!"

# Sol AI Service (Backend boundary only - NEVER expose to client)
# If left empty or as 'mock-key', the AI service uses a safe local deterministic reflection engine.
OPENAI_API_KEY="mock-development-key-replace-with-real-key-if-desired"
OPENAI_MODEL="gpt-4o-mini"

# S3-Compatible Object Storage (Local MinIO or AWS S3)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="empathylink-media"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_PUBLIC_URL="http://localhost:9000/empathylink-media"

# SMTP / Notification Delivery
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASSWORD=""

# Application Endpoints & CORS
PORT="4000"
API_URL="http://localhost:4000"
APP_URL="http://localhost:3000"
CORS_ORIGIN="http://localhost:3000"
NODE_ENV="development"
